---
import InteriorHero from '../../../components/redesign/InteriorHero.astro';
import Layout from '../../../layouts/RedesignLayout.astro';
import ContactBand from '../../../components/redesign/ContactBand.astro';
import Icon from '../../../components/redesign/Icon.astro';
import {services} from '../../../data/redesign-services';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
---
<Layout title={service.title} active="services"><InteriorHero image={service.image} alt={service.imageAlt} label="CARE FOR EVERY MILE"><a class="back-link" href="/redesign/services/"> All services</a><p class="eyebrow">MY MECHANIC · TUCSON, ARIZONA</p><h1>{service.title}</h1><p>{service.intro}</p></InteriorHero><section class="container detail-layout section"><div><h2>How we can help.</h2><ul class="large-list">{service.items.map(item=><li><Icon name="check" size={24}/>{item}</li>)}</ul><h2>Before your visit.</h2><p>To schedule an appointment give us a call at 1-520-904-8551 or request an appointment with your information and requested services. We will get back to you with a confirmation.</p></div><aside class="side-panel"><p class="eyebrow">PLAN YOUR VISIT</p><h2>Ready for your <br/>next mile?</h2><p>Request your preferred visit or give the shop a call.</p><a class="button" href={`/redesign/appointments/?service=${encodeURIComponent(service.title)}`}>Request Appointment</a><a class="text-link" href="tel:5209048551">(520) 904-8551</a>{service.slug==='engine-transmission'&&<a class="text-link" href="/redesign/financing/">Financing available </a>}<a class="text-link" href="/redesign/faq/">Frequently asked questions </a><hr/><p>Monday–Friday <br/>8:00am–5:00pm <br/>4039 N Romero Rd, Tucson</p></aside></section><section class="service-next container section"><p class="eyebrow">KEEP EXPLORING</p><h2>More ways we can help.</h2><div class="related-services">{services.filter(s=>s.slug!==service.slug).slice(0,3).map(s=><a href={`/redesign/services/${s.slug}/`}><Icon name={s.icon} size={30}/><span>{s.title}</span></a>)}</div></section><ContactBand/></Layout>

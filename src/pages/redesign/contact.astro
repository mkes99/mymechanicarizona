---
import ShopMap from '../../components/redesign/ShopMap.astro';
import InteriorHero from '../../components/redesign/InteriorHero.astro';
import Layout from '../../layouts/RedesignLayout.astro';
import Icon from '../../components/redesign/Icon.astro';
---
<Layout title="Contact the Shop" active="contact"><InteriorHero image="/assets/redesign/membership.jpg" alt="Tools and hands working beneath a vehicle hood" label="LET’S TALK ABOUT YOUR CAR"><p class="eyebrow">RIGHT HERE IN TUCSON</p><h1>Let’s talk <br/><em>about your car.</em></h1><p>Have a question before your visit? Give us a call or send a note. Ready for service? Request an appointment.</p><a class="button" href="/redesign/appointments/">Request an Appointment</a></InteriorHero><section class="section container contact-layout"><div class="contact-details"><article><Icon name="pin" size={32}/><div><h2>Come see us.</h2><p>4039 N Romero Rd <br/>Tucson, AZ 85705</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=My+Mechanic+4039+N+Romero+Rd+Tucson+AZ" target="_blank" rel="noopener">Get directions </a></div></article><article><Icon name="clock" size={32}/><div><h2>Shop hours.</h2><p>Monday–Friday: 8:00am–5:00pm <br/>Saturday & Sunday: closed</p></div></article><article><Icon name="phone" size={32}/><div><h2>A real conversation.</h2><a class="phone-number" href="tel:5209048551">(520) 904-8551</a><a class="email-link" href="mailto:support@mymechanicarizona.com">support@mymechanicarizona.com</a></div></article></div><div class="form-panel"><h2>Send us a note.</h2><p>For a preferred service date, use the appointment request.</p><form data-mm-form data-form-name="Contact Form" id="contact-form"><label>Your name<input name="item_meta[1]" autocomplete="name" required/></label><label>Email<input type="email" name="item_meta[3]" autocomplete="email" required/></label><label>Your question<textarea name="item_meta[5]" rows="5" required></textarea></label><button class="button" type="submit">Send Message</button><p data-form-status role="status" aria-live="polite"></p></form></div></section><ShopMap contact/></Layout>

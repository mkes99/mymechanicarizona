---
import ResponsiveImage from '../../components/redesign/ResponsiveImage.astro';
import InteriorHero from '../../components/redesign/InteriorHero.astro';
import Layout from '../../layouts/RedesignLayout.astro';
import {services} from '../../data/redesign-services';
---
<Layout title="Request an Appointment" active="appointments"><section class="booking-wrap"><div class="container appointment-layout section"><div class="appointment-intro"><p class="eyebrow">LET’S GET YOU TAKEN CARE OF</p><h1><span>Request</span> <em>a visit.</em></h1><p>Choose a preferred time. Our team will contact you to confirm availability.</p><ResponsiveImage class="booking-photo" priority src="/assets/redesign/appointment.jpg" alt="A hand holding car keys, ready for a service visit" width="1200" height="800"/><div class="appointment-info"><h3>What happens next?</h3><ol><li>We review your request.</li><li>We contact you to confirm a time.</li><li>You bring your vehicle in.</li></ol><p>Your appointment is not confirmed until you hear from our team.</p></div><div class="visit-prep"><h3>A little detail helps.</h3><p>Include your current mileage, any recent work, and when the problem happens. If you’re unsure which service to choose, select “Something else / not sure” and describe it in your own words.</p><p>For an oil membership visit, choose “Lifetime oil membership.”</p></div><p>Prefer to talk? <br/><a class="phone-number" href="tel:5209048551">(520) 904-8551</a></p><p class="helper">Monday–Friday, 8am–5pm</p></div><div class="form-panel"><form data-mm-form data-form-name="Appointment Form" id="appointment-form"><h2>Tell us how we can help.</h2><div class="field-grid"><label>Your name<input name="item_meta[10]" autocomplete="name" required/></label><label>Phone<input type="tel" name="item_meta[18]" autocomplete="tel" required/></label></div><label>Email <span>(optional)</span><input type="email" name="item_meta[15]" autocomplete="email"/></label><label>Vehicle year, make & model<input name="item_meta[28]" placeholder="e.g. 2018 Toyota Camry" required/></label><label>Service needed<select name="item_meta[96]" required><option value="">Choose a service</option>{services.map(s=><option>{s.title}</option>)}<option>Lifetime oil membership</option><option>Something else / not sure</option></select></label><div class="field-grid"><label>Preferred date<input type="date" name="item_meta[11]" required/></label><label>Preferred time<select name="item_meta[26]" required><option value="">Select a time</option><option>Morning</option><option>Afternoon</option><option>Flexible</option></select></label></div><label>What’s happening? <span>(optional)</span><textarea name="concern" rows="3" placeholder="Tell us about the issue, any noises, warning lights, or anything else."></textarea></label><p class="helper">Monday–Friday, 8am–5pm. Requested times are not guaranteed.</p><button class="button full-width" type="submit">Request Appointment</button><p data-form-status role="status" aria-live="polite"></p></form><div id="appointment-confirmation" hidden role="status"><span class="success-mark" aria-hidden="true">✓</span><h2>Request received.</h2><p>This previews the confirmation customers will see after a successful submission.</p><div class="confirmation-note"><strong>Your appointment is not confirmed yet.</strong><p>Our team will contact you to confirm availability.</p></div><p class="preview-form-note">No request was sent from this design preview.</p><a class="button" href="/redesign/">Back to Home</a><button class="text-link" id="edit-request">Edit preview details</button></div></div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#appointment-form')!;const date=form.elements.namedItem('item_meta[11]') as HTMLInputElement;const service=form.elements.namedItem('item_meta[96]') as HTMLSelectElement;const queryService=new URLSearchParams(location.search).get('service');const selected=queryService==='membership'?'Lifetime oil membership':queryService;if(selected&&Array.from(service.options).some(o=>o.value===selected))service.value=selected;
const now=new Date();date.min=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;date.addEventListener('input',()=>{const day=new Date(date.value+'T12:00:00').getDay();date.setCustomValidity(day===0||day===6?'Please choose Monday through Friday. The shop is closed on weekends.':'');});

</script></Layout>

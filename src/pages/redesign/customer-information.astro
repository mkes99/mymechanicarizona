---
import ResponsiveImage from '../../components/redesign/ResponsiveImage.astro';
import Layout from '../../layouts/RedesignLayout.astro';
import PreviewForm from '../../components/redesign/PreviewForm.astro';
const checks={visit:['First visit customer','First visit this vehicle','Return visit customer','Return visit this vehicle'],benefits:['Maintain Performance and Handling','Safety and Reliability','Not having to bring in your vehicle for repairs / convenience','Just getting to your destination'],lights:['Air Bag / SRS','Maintenance / Maintenance Required','RED Brake Light','Check Engine / Service Engine Soon','Low Coolant','Low Tire','Other'],concerns:['Emissions','Drivability','Check Engine Light','Heating','Brakes','Cooling','Lighting','Transmission','Leaks','Engine','Electrical','Suspension, Steering, Alignment','Oil Change','Other']};
---
<Layout title="Customer Information" active="customer-information"><section class="customer-intro container section"><div><p class="eyebrow">BEFORE YOUR VISIT</p><h1>Customer <br/><em>information.</em></h1><p>Contact details, vehicle information and the concerns you’d like us to look at.</p><a class="text-link" href="/wp-content/uploads/2023/06/MyMechanic-Customer-Info-Sheet-v3.pdf" target="_blank" rel="noopener">Use the PDF version</a></div><ResponsiveImage priority src="/assets/redesign/appointment.jpg" alt="Car keys ready for a service visit" width="1200" height="800"/></section>
<section class="container section customer-workspace"><aside class="form-guide"><h2>Your visit, <br/>step by step.</h2><nav aria-label="Form sections"><a href="#visit">01 Visit information</a><a href="#contact-details">02 Contact details</a><a href="#vehicle-details">03 Your vehicle</a><a href="#customer-acknowledgment">04 Acknowledgment</a></nav><p>Need help completing the form?</p><a class="text-link" href="tel:5209048551">(520) 904-8551</a></aside><form data-local-preview class="customer-form"><p class="form-preview-notice">Form preview — information is not sent or saved.</p><fieldset id="visit"><legend>Visit information</legend><div class="choice-grid">{checks.visit.map(t=><label><input type="checkbox" name="visit" value={t}/>{t}</label>)}</div></fieldset><fieldset id="contact-details"><legend>Contact information</legend><div class="field-grid"><label>Responsible party’s name<input name="responsible-name" autocomplete="name" required/></label><label>Phone<input type="tel" name="phone" autocomplete="tel" required/></label><label>Preferred contact name<input name="contact-name"/></label><label>Email<input type="email" name="email" autocomplete="email"/></label><label>Phone / text<input type="tel" name="text-phone"/></label><label>Address<input name="address" autocomplete="address-line1"/></label><label>Address line 2<input name="address2" autocomplete="address-line2"/></label><label>City<input name="city" autocomplete="address-level2"/></label><label>State<input name="state" autocomplete="address-level1"/></label><label>ZIP / postal code<input name="zip" autocomplete="postal-code"/></label></div><label>Who may we thank for referring you?<select name="referral"><option value="">Please select one</option>{['Yelp','Google','Facebook','Instagram','My Mechanic website','Flyer','Customer','BNI','Other'].map(t=><option>{t}</option>)}</select></label><label>Referrer’s name or details<input name="referral-detail"/></label></fieldset><fieldset id="vehicle-details"><legend>Vehicle information</legend><div class="field-grid"><label>Year<input name="year" inputmode="numeric" required/></label><label>Make<input name="make" required/></label><label>Model<input name="model" required/></label></div><p>Are you aware of your vehicle’s factory requirement for scheduled preventive maintenance?</p><div class="choice-grid">{['Yes','No'].map(t=><label><input type="radio" name="maintenance-awareness" value={t}/>{t}</label>)}</div><h3>What matters most to you?</h3><div class="choice-grid">{checks.benefits.map(t=><label><input type="checkbox" name="benefits" value={t}/>{t}</label>)}</div><h3>Warning lights</h3><div class="choice-grid">{checks.lights.map(t=><label><input type="checkbox" name="lights" value={t}/>{t}</label>)}</div><label>Other warning lights<textarea name="other-lights" rows="2"></textarea></label><h3>Areas of concern</h3><div class="choice-grid">{checks.concerns.map(t=><label><input type="checkbox" name="concerns" value={t}/>{t}</label>)}</div><label>Why did you bring your vehicle to My Mechanic today?<textarea name="visit-reason" rows="4"></textarea></label></fieldset><fieldset id="customer-acknowledgment"><legend>Customer acknowledgment</legend><p>I hereby acknowledge My Mechanic is not responsible for any loss due to theft, fire, accidents, vandalism, or other casualties. I hereby grant My Mechanic employees permission to test drive my vehicle on and off premises. Prior to any vehicle repairs, I will be notified of all charges for vehicle repairs, at which time I will either give a verbal or written consent for the repairs to be performed. I understand additional or unforeseen repairs may be required on vehicle, which I will be advised of beforehand.</p><div class="field-grid"><label>Name<input name="acknowledgment-name"/></label><label>Date<input type="date" name="acknowledgment-date"/></label></div></fieldset><button type="submit" class="button">Review information</button><p hidden data-preview-status tabindex="-1" role="status"></p></form></section><PreviewForm/></Layout>

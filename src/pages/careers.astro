---
import Layout from '../layouts/RedesignLayout.astro';
import InteriorHero from '../components/redesign/InteriorHero.astro';
import PreviewForm from '../components/redesign/PreviewForm.astro';
const perks=['GREAT PAY! We pay well to keep good people!!','Paid Birthday off','Personal days','Paid training days and continuing education','Well staffed with knowledgeable techs and service writers','Uniforms provided','Heated and well ventilated shop','Clean, modern, professional facility with modern diagnostic equipment provided','Family owned','Opportunity for advancement and performance based pay','Great online ratings and reviews','Great reputation in the community','Growing company expanding quickly'];
---
<Layout title="Careers" active="careers"><InteriorHero image="/wp-content/uploads/2020/03/IMG_1059-scaled-e1681152170569.jpeg" alt="The Fundamentals wall inside My Mechanic"><p class="eyebrow">JOIN OUR TEAM</p><h1>We are always looking <br/><em>for good people!</em></h1><p>Putting life and family before work is always important to us.</p><a class="button" href="#careers-application">Introduce yourself</a></InteriorHero><div class="career-ribbon"><div class="container"><strong>No weekends</strong><span>5 days a week · 8am–5pm</span><span>Paid training &amp; continuing education</span></div></div><section class="container section career-story"><div><p class="eyebrow">ABOUT THE JOB</p><h2>A place to work. <br/><em>Room to learn.</em></h2><p>If you’re sick of working weird hours and weekends, or just looking for more opportunities, this could be the shop for you. We strive for a personable, non-intimidating environment for not only customers, but employees as well.</p><p>This is a busy shop, working on most makes and models. To help us keep up with the ever changing automotive industry, continuing education is always paid for and encouraged, for all employees.</p></div><div class="career-requirements"><h3>What we’re looking for</h3><ul><li>Full time positions</li><li>Pay determined on experience and skills</li><li>Certifications are preferred either from manufacturers, ASE, or other training institutions</li><li>Willingness to learn and good team skills are a must!</li></ul></div></section><section class="career-benefits"><div class="container section"><p class="eyebrow">WHAT WE OFFER</p><h2>More than a place <br/>to clock in.</h2><ul>{perks.map(p=><li>{p}</li>)}</ul></div></section><section id="careers-application" class="container section career-apply"><div><p class="eyebrow">APPLY NOW</p><h2>We look forward <br/>to hearing from you.</h2><p>Please enter your information below.</p><a class="text-link" href="tel:5209048551">Questions? Call (520) 904-8551</a></div><form data-local-preview><p class="form-preview-notice">Application preview — information and files are not sent or saved.</p><div class="field-grid"><label>Name<input name="name" autocomplete="name" required/></label><label>Phone<input name="phone" type="tel" autocomplete="tel" required/></label></div><label>Email<input name="email" type="email" autocomplete="email" required/></label><label>Application<textarea name="application" rows="5"></textarea></label><label class="resume-upload">Your résumé<input name="resume" type="file" accept=".pdf,.doc,.docx"/><span>Maximum file size: 20MB</span></label><button class="button" type="submit">Review application</button><p hidden data-preview-status tabindex="-1" role="status"></p></form></section><PreviewForm/><script>const resume=document.querySelector<HTMLInputElement>('input[name="resume"]');resume?.addEventListener('change',()=>resume.setCustomValidity((resume.files?.[0]?.size??0)>20*1024*1024?'Choose a file smaller than 20MB.':''));</script></Layout>

---
import ResponsiveImage from '../components/redesign/ResponsiveImage.astro';
import ShopMap from '../components/redesign/ShopMap.astro';
import GoogleRating from '../components/redesign/GoogleRating.astro';
import Layout from '../layouts/RedesignLayout.astro';
import Icon from '../components/redesign/Icon.astro';
import MembershipBanner from '../components/redesign/MembershipBanner.astro';
import ContactBand from '../components/redesign/ContactBand.astro';
import content from '../data/redesign-content.json';
import {services} from '../data/redesign-services';
---
<Layout>
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"AutoRepair",name:"My Mechanic Maintenance & Repair",address:{"@type":"PostalAddress",streetAddress:"4039 N Romero Rd",addressLocality:"Tucson",addressRegion:"AZ",postalCode:"85705",addressCountry:"US"},telephone:"(520) 904-8551",openingHours:"Mo-Fr 08:00-17:00",url:"https://www.mymechanicarizona.com/",geo:{"@type":"GeoCoordinates",latitude:"{{LAT}}",longitude:"{{LNG}}"}})}/>

<section class="hero container"><div class="hero-copy"><p class="eyebrow">YOUR NEIGHBORHOOD TUCSON AUTO SHOP</p><h1>Honest auto repair, <br/><em>right here in Tucson.</em></h1><p class="hero-description">25+ years of experience. Straightforward advice and dependable repairs.</p><div class="hero-actions"><a class="button hero-book" href="/appointments/">Request an Appointment</a><a class="call-link" href="tel:5209048551"><Icon name="phone" size={26}/><span><strong>Call the Shop</strong><small>(520) 904-8551</small></span></a></div><GoogleRating/></div><div class="hero-photo"><ResponsiveImage src="/assets/redesign/shop.jpeg" alt="The My Mechanic shop on North Romero Road in Tucson" width="2560" height="1709" priority/></div></section>
<section class="trust-strip container" aria-label="Why choose My Mechanic"><div>25+ years of experience</div><div>ASE-certified technicians</div><div>36-month / 36,000-mile nationwide warranty</div><div>Free loaner cars &amp; shuttle</div></section>
<section class="reviews-section" id="reviews"><div class="container review-stage"><div class="review-intro"><p class="eyebrow">WORD AROUND TUCSON</p><h2>Real care. <br/><em>Lasting trust.</em></h2><a class="text-link" href={content.googleProfileUrl} target="_blank" rel="noopener">Read all reviews on Google </a></div><div class="review-voices">{content.reviews.map((review,i)=><figure class:list={['review-voice',{'featured':i===0}]}><div class="review-source"><span class="review-stars" aria-label="5 out of 5 stars">★★★★★</span><span>Google review</span></div><blockquote>{review.quote}</blockquote><figcaption><strong>{review.firstName.replace(/\b\w/g, c=>c.toUpperCase())}</strong><span>{review.date}</span></figcaption></figure>)}</div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">OUR SERVICES</p><h2>Whatever brings you in, let’s get it sorted.</h2></div><a class="text-link" href="/services/">All services </a></div><div class="service-cards">{services.map(s=><a href={`/services/${s.slug}/`} class="service-card" data-service={s.slug}><div class="service-photo-frame"><ResponsiveImage sizes="(max-width: 600px) 100vw, (max-width: 800px) 50vw, 33vw" class="service-photo" src={s.image} alt="" width="1200" height="800" loading="lazy"/></div><div><h3>{s.title}</h3><p>{s.summary}</p>{s.slug==='engine-transmission'&&<span class="finance-note">Financing available</span>}</div></a>)}</div></section>
<section class="fleet-band"><div class="container"><h2>Running a fleet? Keep your vehicles on the road.</h2><a class="button" href="tel:5209048551">Call about fleet service</a></div></section>
<MembershipBanner/>
<section class="section container home-about"><div class="story-copy"><p class="eyebrow">LOCAL ROOTS. REAL PEOPLE.</p><h2>A repair shop you can feel good coming back to.</h2><div class="home-about-grid"><p>We work with each customer on an individual basis to help decide which route of repair will work best for them.</p><div><h3>Clear conversations</h3><p>Every Team member is available to talk to customers about what we do.</p></div><div><h3>No surprises</h3><p>We offer fair and transparent pricing and provide estimates upfront for hundreds of services on thousands of cars.</p></div><a class="text-link" href="/our-shop/">Get to know us </a></div></div><ResponsiveImage class="home-about-photo" src="/wp-content/uploads/2020/03/IMG_1059-scaled-e1681152170569.jpeg" alt="The Fundamentals plaques on the wall at My Mechanic" width="1200" height="1600" loading="lazy"/></section>
<ShopMap combined/>
</Layout>
